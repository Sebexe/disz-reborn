import jStat from "https://cdn.skypack.dev/jstat";

interface CalcularLimitesInput {
  dRaya: number;
  desvioD: number; // Puede ser varianza o desviación estándar dependiendo de esVarianza
  n: number;
  alfa: number;
  esVarianza: boolean;
}

interface CalcularLimitesOutput {
  limiteInferior: number;
  limiteSuperior: number;
  errorMuestral: number;
}

function calcularLimites(input: CalcularLimitesInput): CalcularLimitesOutput {
  const { dRaya, desvioD, n, alfa, esVarianza } = input;
  const degreesOfFreedom = n - 1;

  // Convertir a desviación estándar si es necesario
  const standardDeviation = esVarianza ? Math.sqrt(desvioD) : desvioD;

  // Calcular el error estándar
  const standardError = standardDeviation / Math.sqrt(n);

  // Calcular el valor crítico de t
  const tCritico = jStat.studentt.inv(1 - alfa / 2, degreesOfFreedom);

  // Calcular el error muestral
  const errorMuestral = tCritico * standardError;

  // Calcular los límites inferior y superior
  const limiteInferior = dRaya - errorMuestral;
  const limiteSuperior = dRaya + errorMuestral;

  return {
    limiteInferior: parseFloat(limiteInferior.toFixed(8)),
    limiteSuperior: parseFloat(limiteSuperior.toFixed(8)),
    errorMuestral: parseFloat(errorMuestral.toFixed(8)),
  };
}

interface CalcularMuestraInput {
  errorBuscado: number;
  alfa: number;
  desvioD: number; // Puede ser varianza o desviación estándar dependiendo de esVarianza
  esVarianza: boolean;
}

interface CalcularMuestraOutput {
  n: number;
}

function calcularMuestra(input: CalcularMuestraInput): CalcularMuestraOutput {
  const { errorBuscado, alfa, desvioD, esVarianza } = input;
  let n = 2;

  // Convertir a desviación estándar si es necesario
  const standardDeviation = esVarianza ? Math.sqrt(desvioD) : desvioD;

  while (true) {
    const degreesOfFreedom = n - 1;
    const tCritico = jStat.studentt.inv(1 - alfa / 2, degreesOfFreedom);
    const muestraCalculada = Math.pow(
      (standardDeviation * tCritico) / errorBuscado,
      2,
    );

    if (muestraCalculada <= n) {
      break;
    }

    n += 1;
  }

  return { n };
}

export { calcularLimites, calcularMuestra };
