import jStat from 'https://cdn.skypack.dev/jstat';

interface CalcularLimitesVarianzaConocidaInput {
    muestra1: number;
    muestra2: number;
    media1: number;
    media2: number;
    varianza1: number; // Puede ser varianza o desviación estándar al cuadrado
    varianza2: number;
    alfa: number;
    esVarianza: boolean;
}

interface CalcularLimitesVarianzaConocidaOutput {
    limiteInferior: number;
    limiteSuperior: number;
    errorMuestral: number;
}

function calcularLimitesVarianzaConocida(input: CalcularLimitesVarianzaConocidaInput): CalcularLimitesVarianzaConocidaOutput {
    const { muestra1, muestra2, media1, media2, varianza1, varianza2, alfa, esVarianza } = input;

    // Si es desviación estándar, elevamos al cuadrado para obtener la varianza
    const var1 = esVarianza ? varianza1 : varianza1 ** 2;
    const var2 = esVarianza ? varianza2 : varianza2 ** 2;

    const diferenciaMedias = media1 - media2;
    const z = jStat.normal.inv(1 - alfa / 2, 0, 1);
    const errorTerm = z * Math.sqrt(var1 / muestra1 + var2 / muestra2);

    const limiteInferior = diferenciaMedias - errorTerm;
    const limiteSuperior = diferenciaMedias + errorTerm;
    const errorMuestral = errorTerm;

    return {
        limiteInferior: parseFloat(limiteInferior.toFixed(8)),
        limiteSuperior: parseFloat(limiteSuperior.toFixed(8)),
        errorMuestral: parseFloat(errorMuestral.toFixed(8)),
    };
}

interface CalcularMuestraRequeridaInput {
    varianza1: number; // Puede ser varianza o desviación estándar al cuadrado
    varianza2: number;
    errorMuestral: number;
    alfa: number;
    esVarianza: boolean;
}

interface CalcularMuestraRequeridaOutput {
    n: number;
}

function calcularMuestraRequerida(input: CalcularMuestraRequeridaInput): CalcularMuestraRequeridaOutput {
    const { varianza1, varianza2, errorMuestral, alfa, esVarianza } = input;

    // Si es desviación estándar, elevamos al cuadrado para obtener la varianza
    const var1 = esVarianza ? varianza1 : varianza1 ** 2;
    const var2 = esVarianza ? varianza2 : varianza2 ** 2;

    const z = jStat.normal.inv(1 - alfa / 2, 0, 1);
    const n = ((z * Math.sqrt(var1 + var2)) / errorMuestral) ** 2;

    return {
        n: parseFloat(n.toFixed(8)),
    };
}


export {calcularLimitesVarianzaConocida, calcularMuestraRequerida};