import jStat from 'https://cdn.skypack.dev/jstat';

interface CalcularLimitesInput {
  n1: number;
  n2: number;
  desvio1: number; // Puede ser desviación estándar o varianza dependiendo de esVarianza
  desvio2: number;
  media1: number;
  media2: number;
  alfa: number;
  esVarianza: boolean;
}

interface CalcularLimitesOutput {
  limiteInferior: number;
  limiteSuperior: number;
  errorMuestral: number;
}

function calcularLimites(input: CalcularLimitesInput): CalcularLimitesOutput {
  const { n1, n2, desvio1, desvio2, media1, media2, alfa, esVarianza } = input;

  // Convertir a varianza si es necesario
  const s1Squared = esVarianza ? desvio1 : desvio1 ** 2;
  const s2Squared = esVarianza ? desvio2 : desvio2 ** 2;

  // Calcular grados de libertad aproximados de Welch
  const numerator = (s1Squared / n1 + s2Squared / n2) ** 2;
  const denominator =
    (s1Squared / n1) ** 2 / (n1 - 1) + (s2Squared / n2) ** 2 / (n2 - 1);
  const gradosAproximadosWelch = Math.floor(numerator / denominator);

  // Calcular el valor crítico de t
  const tValue = jStat.studentt.inv(1 - alfa / 2, gradosAproximadosWelch);

  // Calcular el error muestral
  const errorTerm = tValue * Math.sqrt(s1Squared / n1 + s2Squared / n2);

  // Calcular los límites inferior y superior
  const diferenciaMedias = media1 - media2;
  const limiteInferior = diferenciaMedias - errorTerm;
  const limiteSuperior = diferenciaMedias + errorTerm;
  const errorMuestral = errorTerm;

  return {
    limiteInferior: parseFloat(limiteInferior.toFixed(8)),
    limiteSuperior: parseFloat(limiteSuperior.toFixed(8)),
    errorMuestral: parseFloat(errorMuestral.toFixed(8)),
  };
}

interface CalcularMuestraRequeridaInput {
  desvio1: number; // Puede ser desviación estándar o varianza dependiendo de esVarianza
  desvio2: number;
  alfa: number;
  error: number;
  esVarianza: boolean;
}

interface CalcularMuestraRequeridaOutput {
  n: number;
}

function calcularMuestraRequerida(
  input: CalcularMuestraRequeridaInput
): CalcularMuestraRequeridaOutput {
  const { desvio1, desvio2, alfa, error, esVarianza } = input;
  let n = 2; // Valor inicial de n

  // Convertir a varianza si es necesario
  const s1Squared = esVarianza ? desvio1 : desvio1 ** 2;
  const s2Squared = esVarianza ? desvio2 : desvio2 ** 2;

  while (true) {
    // Calcular grados de libertad aproximados de Welch
    const numerator = (s1Squared / n + s2Squared / n) ** 2;
    const denominator =
      (s1Squared / n) ** 2 / (n - 1) + (s2Squared / n) ** 2 / (n - 1);
    const gradosAproximadosWelch = Math.floor(numerator / denominator);

    // Calcular el valor crítico de t
    const tValue = jStat.studentt.inv(1 - alfa / 2, gradosAproximadosWelch);

    // Calcular el nuevo valor de n
    const nNuevo =
      ((tValue / error) ** 2) * (s1Squared + s2Squared);

    const nRedondeado = Math.ceil(nNuevo);

    if (nRedondeado === n) {
      break;
    }

    n = nRedondeado;
  }

  return {
    n,
  };
}


export { calcularLimites, calcularMuestraRequerida };