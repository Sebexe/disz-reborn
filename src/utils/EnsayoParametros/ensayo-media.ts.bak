import jStat from 'https://cdn.skypack.dev/jstat';


interface DatosCondicionRechazo {
  valorCritico: number;
  sigma: number;
  alpha: number;
  muestra: number;
  tipoDeCola: "izquierda >=" | "derecha" | "doble";
}

interface DatosErrorTipo2 {
  valorCritico: number;
  sigma: number;
  muestra: number;
  mediaReal: number;
  tipoDeCola: "izquierda >=" | "derecha" | "doble";
  valorCriticoSuperior?: number;
  valorCriticoInferior?: number;
}

interface DatosMuestraRequerida {
  sigma: number;
  alpha: number;
  beta: number;
  mediaReal: number;
  valorCritico: number;
}

function calcularCondicionRechazo(datos: DatosCondicionRechazo) {
  const { valorCritico, sigma, alpha, muestra, tipoDeCola } = datos;

  let valorNormal: number;
  let condicionRechazo: number | [number, number];

  if (tipoDeCola === "izquierda >=") {
    valorNormal = 1 - alpha;
  } else if (tipoDeCola === "derecha") {
    valorNormal = alpha;
  } else {
    valorNormal = 1 - alpha / 2;
  }

  if (tipoDeCola === "izquierda >=" || tipoDeCola === "derecha") {
    condicionRechazo =
      valorCritico - (jStat.normal.inv(valorNormal, 0, 1) * sigma) / Math.sqrt(muestra);
  } else {
    const limiteInferior =
      valorCritico - (jStat.normal.inv(1 - alpha / 2, 0, 1) * sigma) / Math.sqrt(muestra);
    const limiteSuperior =
      valorCritico + (jStat.normal.inv(1 - alpha / 2, 0, 1) * sigma) / Math.sqrt(muestra);
    condicionRechazo = [limiteInferior, limiteSuperior];
  }

  return condicionRechazo;
}

function calcularErrorTipo2(datos: DatosErrorTipo2) {
  const { valorCritico, sigma, muestra, mediaReal, tipoDeCola, valorCriticoSuperior, valorCriticoInferior } = datos;

  let beta: number;

  if (tipoDeCola === "izquierda >=") {
    const z_beta = jStat.normal.cdf((valorCritico - mediaReal) / (sigma / Math.sqrt(muestra)), 0, 1);
    beta = 1 - z_beta;
  } else if (tipoDeCola === "derecha") {
    const z_beta = jStat.normal.cdf((valorCritico - mediaReal) / (sigma / Math.sqrt(muestra)), 0, 1);
    beta = z_beta;
  } else if (tipoDeCola === "doble" && valorCriticoSuperior !== undefined && valorCriticoInferior !== undefined) {
    const z_beta1 = jStat.normal.cdf((valorCriticoSuperior - mediaReal) / (sigma / Math.sqrt(muestra)), 0, 1);
    const z_beta2 = jStat.normal.cdf((valorCriticoInferior - mediaReal) / (sigma / Math.sqrt(muestra)), 0, 1);
    beta = z_beta1 - z_beta2;
  } else {
    throw new Error("Datos no válidos para calcular error tipo 2.");
  }

  return {
    beta: beta,
    poder: 1 - beta
  };
}

function calcularMuestraRequerida(datos: DatosMuestraRequerida) {
  const { sigma, alpha, beta, mediaReal, valorCritico } = datos;

  const z_alpha = jStat.normal.inv(1 - alpha, 0, 1);
  const z_beta = jStat.normal.inv(1 - beta, 0, 1);

  const muestra = Math.pow((z_alpha + z_beta) * sigma / (mediaReal - valorCritico), 2);

  return Math.ceil(muestra);
}
export {calcularCondicionRechazo,calcularErrorTipo2,calcularMuestraRequerida}


if (import.meta.main) {
  

  console.log(calcularCondicionRechazo({alpha:0.1,muestra:10,sigma:0.1,tipoDeCola:"derecha",valorCritico:1}));
  console.log(calcularErrorTipo2({mediaReal:1.05,sigma:0.1,muestra:10,tipoDeCola:"derecha",valorCritico:1.0405262188607551}));
  console.log(calcularMuestraRequerida({alpha:0.1,beta:0.1,mediaReal:1.05,valorCritico:1,sigma:0.1}));
  
   
  

}